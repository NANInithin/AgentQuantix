# Normalise line endings in the repo, check out native on each platform.
* text=auto

# These MUST be LF wherever they land. A shell script checked out with CRLF
# fails on Linux with "bad interpreter: /usr/bin/env bash^M", which is a
# baffling error for someone whose first contact with this project is piping
# install.sh into bash.
*.sh text eol=lf
install.sh text eol=lf

# Windows-native, so keep CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
